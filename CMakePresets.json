{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x86",
      "displayName": "Windows 32-bit (open.mp and SA-MP)",
      "description": "Visual Studio 2022, dependencies from vcpkg (requires the VCPKG_ROOT environment variable)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "DISCORD_BRIDGE_STATIC_DEPS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
