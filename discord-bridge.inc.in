#if defined _discord_bridge_included
	#endinput
#endif
#define _discord_bridge_included

#define DISCORD_BRIDGE_VERSION "@PROJECT_VERSION@"
#define DISCORD_BRIDGE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define DISCORD_BRIDGE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define DISCORD_BRIDGE_VERSION_PATCH @PROJECT_VERSION_PATCH@

// -----------------------
// Primary API (project-native naming)
// -----------------------

enum DiscordChannelType
{
	DISCORD_GUILD_TEXT = 0,
	DISCORD_DM = 1,
	DISCORD_GUILD_VOICE = 2,
	DISCORD_GROUP_DM = 3,
	DISCORD_GUILD_CATEGORY = 4,
	DISCORD_GUILD_NEWS = 5,
	DISCORD_GUILD_STORE = 6,
	DISCORD_GUILD_NEWS_THREAD = 10,
	DISCORD_GUILD_PUBLIC_THREAD = 11,
	DISCORD_GUILD_PRIVATE_THREAD = 12,
	DISCORD_GUILD_STAGE_VOICE = 13,
	DISCORD_GUILD_DIRECTORY = 14,
	DISCORD_GUILD_FORUM = 15,
	DISCORD_GUILD_MEDIA = 16
};

enum DiscordUserPresenceStatus
{
	DISCORD_PRESENCE_INVALID = 0,
	DISCORD_PRESENCE_ONLINE = 1,
	DISCORD_PRESENCE_IDLE = 2,
	DISCORD_PRESENCE_DO_NOT_DISTURB = 3,
	DISCORD_PRESENCE_OFFLINE = 4
};

enum DiscordBotPresenceStatus
{
	DISCORD_BOT_PRESENCE_INVALID = 0,
	DISCORD_BOT_PRESENCE_ONLINE,
	DISCORD_BOT_PRESENCE_IDLE,
	DISCORD_BOT_PRESENCE_DO_NOT_DISTURB,
	DISCORD_BOT_PRESENCE_INVISIBLE,
	DISCORD_BOT_PRESENCE_OFFLINE
};

enum DiscordMessageReactionType
{
	DISCORD_REACTION_ADD = 0,
	DISCORD_REACTION_REMOVE,
	DISCORD_REACTION_REMOVE_ALL,
	DISCORD_REACTION_REMOVE_EMOJI
};

#define DISCORD_INVALID_CHANNEL DiscordChannel:0
#define DISCORD_INVALID_USER DiscordUser:0
#define DISCORD_INVALID_ROLE DiscordRole:0
#define DISCORD_INVALID_GUILD DiscordGuild:0

#define DISCORD_ID_SIZE (20 + 1)
#define DISCORD_USERNAME_SIZE (32 + 1)
#define DISCORD_NICKNAME_SIZE (32 + 1)
#define DISCORD_EMOJI_NAME_SIZE (32 + 1)
#define DISCORD_COMMAND_SIZE (32 + 1)
#define DISCORD_COMMAND_DESCRIPTION_SIZE (32 + 1)

native bool:ConnectDiscordBot(const token[], intents = 131071);
native bool:IsDiscordConnected();

native DiscordChannel:FindDiscordChannelByID(const channel_id[]);
native DiscordChannel:FindDiscordChannelByName(const channel_name[]);
native DiscordChannel:FindDiscordConfiguredChannel();
native GetDiscordChannelID(DiscordChannel:channel, dest[DISCORD_ID_SIZE], max_size = sizeof dest);
native GetDiscordChannelType(DiscordChannel:channel, &DiscordChannelType:type);
native GetDiscordChannelGuild(DiscordChannel:channel, &DiscordGuild:guild);
native GetDiscordChannelName(DiscordChannel:channel, dest[], max_size = sizeof dest);
native GetDiscordChannelTopic(DiscordChannel:channel, dest[], max_size = sizeof dest);
native GetDiscordChannelPosition(DiscordChannel:channel, &position);
native IsDiscordChannelNsfw(DiscordChannel:channel, &bool:is_nsfw);
native GetDiscordChannelParentCategory(DiscordChannel:channel, &DiscordChannel:category);
native SendDiscordChannelMessage(DiscordChannel:channel, const message[], const callback[] = "", const format[] = "", {Float, _}:...);
native SetDiscordChannelName(DiscordChannel:channel, const name[]);
native SetDiscordChannelTopic(DiscordChannel:channel, const topic[]);
native SetDiscordChannelPosition(DiscordChannel:channel, position);
native SetDiscordChannelNsfw(DiscordChannel:channel, bool:is_nsfw);
native SetDiscordChannelParentCategory(DiscordChannel:channel, DiscordChannel:parent_category);
native DeleteDiscordChannel(DiscordChannel:channel);

native DiscordUser:FindDiscordUserByID(const user_id[]);
native DiscordUser:FindDiscordUserByName(const user_name[], const user_discriminator[] = "");
native GetDiscordUserID(DiscordUser:user, dest[DISCORD_ID_SIZE], max_size = DISCORD_ID_SIZE);
native GetDiscordUserName(DiscordUser:user, dest[DISCORD_USERNAME_SIZE], max_size = sizeof dest);
native GetDiscordUserDiscriminator(DiscordUser:user, dest[], max_size = sizeof dest);
native IsDiscordUserBot(DiscordUser:user, &bool:is_bot);
native IsDiscordUserVerified(DiscordUser:user, &bool:is_verified);

native DiscordGuild:FindDiscordGuildByID(const guild_id[]);
native DiscordGuild:FindDiscordGuildByName(const guild_name[]);
native GetDiscordGuildID(DiscordGuild:guild, dest[DISCORD_ID_SIZE], max_size = sizeof dest);
native GetDiscordGuildName(DiscordGuild:guild, dest[], max_size = sizeof dest);
native GetDiscordGuildOwnerID(DiscordGuild:guild, dest[DISCORD_ID_SIZE], max_size = sizeof dest);

native DiscordRole:FindDiscordRoleByID(const role_id[]);
native DiscordRole:FindDiscordRoleByName(DiscordGuild:guild, const role_name[]);
native GetDiscordRoleID(DiscordRole:role, dest[DISCORD_ID_SIZE], max_size = sizeof dest);
native GetDiscordRoleName(DiscordRole:role, dest[], max_size = sizeof dest);
native GetDiscordRoleColour(DiscordRole:role, &colour);
native GetDiscordRoleColor(DiscordRole:role, &color) = GetDiscordRoleColour;
native GetDiscordRolePermissions(DiscordRole:role, &perm_high, &perm_low);
native IsDiscordRoleHoist(DiscordRole:role, &bool:is_hoist);
native GetDiscordRolePosition(DiscordRole:role, &position);
native IsDiscordRoleMentionable(DiscordRole:role, &bool:is_mentionable);

native GetDiscordGuildRole(DiscordGuild:guild, offset, &DiscordRole:role);
native GetDiscordGuildRoleCount(DiscordGuild:guild, &count);
native GetDiscordGuildMember(DiscordGuild:guild, offset, &DiscordUser:user);
native GetDiscordGuildMemberCount(DiscordGuild:guild, &count);
native GetDiscordGuildMemberVoiceChannel(DiscordGuild:guild, DiscordUser:user, &DiscordChannel:channel);
native GetDiscordGuildMemberNickname(DiscordGuild:guild, DiscordUser:user, dest[DISCORD_NICKNAME_SIZE], max_size = sizeof dest);
native GetDiscordGuildMemberRole(DiscordGuild:guild, DiscordUser:user, offset, &DiscordRole:role);
native GetDiscordGuildMemberRoleCount(DiscordGuild:guild, DiscordUser:user, &count);
native HasDiscordGuildMemberRole(DiscordGuild:guild, DiscordUser:user, DiscordRole:role, &bool:has_role);
native GetDiscordGuildMemberStatus(DiscordGuild:guild, DiscordUser:user, &DiscordUserPresenceStatus:status);
native GetDiscordGuildChannel(DiscordGuild:guild, offset, &DiscordChannel:channel);
native GetDiscordGuildChannelCount(DiscordGuild:guild, &count);
native GetDiscordAllGuilds(DiscordGuild:dest[], max_size = sizeof dest);

native SetDiscordGuildName(DiscordGuild:guild, const name[]);
native CreateDiscordGuildChannel(DiscordGuild:guild, const name[], DiscordChannelType:type, const callback[] = "", const format[] = "", {Float, _}:...);
native DiscordChannel:GetDiscordCreatedGuildChannel();
native SetDiscordGuildMemberNickname(DiscordGuild:guild, DiscordUser:user, const nickname[]);
native SetDiscordGuildMemberVoiceChannel(DiscordGuild:guild, DiscordUser:user, DiscordChannel:channel);
native AddDiscordGuildMemberRole(DiscordGuild:guild, DiscordUser:user, DiscordRole:role);
native RemoveDiscordGuildMemberRole(DiscordGuild:guild, DiscordUser:user, DiscordRole:role);
native RemoveDiscordGuildMember(DiscordGuild:guild, DiscordUser:user);
native CreateDiscordGuildMemberBan(DiscordGuild:guild, DiscordUser:user, const reason[] = "");
native RemoveDiscordGuildMemberBan(DiscordGuild:guild, DiscordUser:user);
native SetDiscordGuildRolePosition(DiscordGuild:guild, DiscordRole:role, position);
native SetDiscordGuildRoleName(DiscordGuild:guild, DiscordRole:role, const name[]);
native SetDiscordGuildRolePermissions(DiscordGuild:guild, DiscordRole:role, perm_high, perm_low);
native SetDiscordGuildRoleColour(DiscordGuild:guild, DiscordRole:role, colour);
native SetDiscordGuildRoleColor(DiscordGuild:guild, DiscordRole:role, color) = SetDiscordGuildRoleColour;
native SetDiscordGuildRoleHoist(DiscordGuild:guild, DiscordRole:role, bool:hoist);
native SetDiscordGuildRoleMentionable(DiscordGuild:guild, DiscordRole:role, bool:mentionable);
native CreateDiscordGuildRole(DiscordGuild:guild, const name[], const callback[] = "", const format[] = "", {Float, _}:...);
native DiscordRole:GetDiscordCreatedGuildRole();
native DeleteDiscordGuildRole(DiscordGuild:guild, DiscordRole:role);

native CacheDiscordChannelMessage(const channel_id[DISCORD_ID_SIZE], const message_id[DISCORD_ID_SIZE], const callback[] = "", const format[] = "", {Float, _}:...);
native GetDiscordMessageID(DiscordMessage:message, dest[DISCORD_ID_SIZE], max_size = DISCORD_ID_SIZE);
native GetDiscordMessageChannel(DiscordMessage:message, &DiscordChannel:channel);
native GetDiscordMessageAuthor(DiscordMessage:message, &DiscordUser:author);
native GetDiscordMessageContent(DiscordMessage:message, dest[], max_size = sizeof dest);
native IsDiscordMessageTTS(DiscordMessage:message, &bool:is_tts);
native IsDiscordMessageMentioningEveryone(DiscordMessage:message, &bool:mentions_everyone);
native GetDiscordMessageUserMentionCount(DiscordMessage:message, &mentioned_user_count);
native GetDiscordMessageUserMention(DiscordMessage:message, offset, &DiscordUser:mentioned_user);
native GetDiscordMessageRoleMentionCount(DiscordMessage:message, &mentioned_role_count);
native GetDiscordMessageRoleMention(DiscordMessage:message, offset, &DiscordRole:mentioned_role);
native DiscordMessage:GetDiscordCreatedMessage();
native DeleteDiscordInternalMessage(DiscordMessage:message);
native DeleteDiscordMessage(DiscordMessage:message);
native EditDiscordMessage(DiscordMessage:message, const content[], DiscordEmbed:embed = DiscordEmbed:0);
native SetDiscordMessagePersistent(DiscordMessage:message, bool:persistent);

native DiscordBotPresenceStatus:GetDiscordBotPresenceStatus();
native TriggerDiscordBotTypingIndicator(DiscordChannel:channel);
native SetDiscordBotNickname(DiscordGuild:guild, const nickname[]);
stock ClearDiscordBotNickname(DiscordGuild:guild)
{
	return SetDiscordBotNickname(guild, "");
}
native DiscordChannel:CreateDiscordPrivateChannel(DiscordUser:user, const callback[], const format[] = "", {Float, _}:...);
native DiscordChannel:GetDiscordCreatedPrivateChannel();
native SetDiscordBotPresenceStatus(DiscordBotPresenceStatus:status);
native SetDiscordBotActivity(const name[]);
stock ClearDiscordBotActivity()
{
	return SetDiscordBotActivity("");
}

native EscapeDiscordMarkdown(const src[], dest[], max_size = sizeof dest);

native DiscordEmbed:CreateDiscordEmbed(const title[] = "", const description[] = "", const url[] = "", const timestamp[] = "", colour = 0, const footer_text[] = "", const footer_icon_url[] = "", const thumbnail_url[] = "", const image_url[] = "");
native DeleteDiscordEmbed(DiscordEmbed:embed);
native SendDiscordChannelEmbedMessage(DiscordChannel:channel, DiscordEmbed:embed, const message[] = "", const callback[] = "", const format[] = "", {Float, _}:...);
native AddDiscordEmbedField(DiscordEmbed:embed, const name[], const value[], bool:inline = false);
native SetDiscordEmbedTitle(DiscordEmbed:embed, const title[]);
native SetDiscordEmbedDescription(DiscordEmbed:embed, const description[]);
native SetDiscordEmbedURL(DiscordEmbed:embed, const url[]);
native SetDiscordEmbedTimestamp(DiscordEmbed:embed, const timestamp[]);
native SetDiscordEmbedColour(DiscordEmbed:embed, colour);
native SetDiscordEmbedColor(DiscordEmbed:embed, color) = SetDiscordEmbedColour;
native SetDiscordEmbedFooter(DiscordEmbed:embed, const footer_text[], const footer_icon_url[] = "");
native SetDiscordEmbedThumbnail(DiscordEmbed:embed, const thumbnail_url[]);
native SetDiscordEmbedImage(DiscordEmbed:embed, const image_url[]);

native DiscordEmoji:CreateDiscordEmoji(const name[DISCORD_EMOJI_NAME_SIZE], const snowflake[DISCORD_ID_SIZE] = "");
native DeleteDiscordEmoji(DiscordEmoji:emoji);
native GetDiscordEmojiName(DiscordEmoji:emoji, dest[DISCORD_EMOJI_NAME_SIZE], maxlen = DISCORD_EMOJI_NAME_SIZE);
native CreateDiscordReaction(DiscordMessage:message, DiscordEmoji:reaction_emoji);
native DeleteDiscordMessageReaction(DiscordMessage:message, DiscordEmoji:reaction_emoji = DiscordEmoji:0);

native DiscordCommand:CreateDiscordCommand(const command_name[DISCORD_COMMAND_SIZE], const description[DISCORD_COMMAND_DESCRIPTION_SIZE], const callback[], bool:allow_everyone = true, DiscordGuild:guild = DISCORD_INVALID_GUILD);
native DeleteDiscordCommand(DiscordCommand:command);

native GetDiscordInteractionMentionCount(DiscordInteraction:interaction, &mentioned_user_count);
native GetDiscordInteractionMention(DiscordInteraction:interaction, offset, &DiscordUser:mentioned_user);
native GetDiscordInteractionContent(DiscordInteraction:interaction, dest[], max_size = sizeof dest);
native GetDiscordInteractionChannel(DiscordInteraction:interaction, &DiscordChannel:channel);
native GetDiscordInteractionGuild(DiscordInteraction:interaction, &DiscordGuild:guild);
native SendDiscordInteractionEmbed(DiscordInteraction:interaction, DiscordEmbed:embed, const message[] = "");
native SendDiscordInteractionMessage(DiscordInteraction:interaction, const message[] = "");

